<Window x:Class="MrtRouteSimulator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MRT 路線進出站時間模擬器"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#182238" Offset="0" />
                    <GradientStop Color="#293A59" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="MRT 路線進出站時間模擬器" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionSummaryText" Foreground="#C8D0DF" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#24324C" BorderBrush="#53617A" BorderThickness="1" CornerRadius="18" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#35C78A" Margin="0,0,8,0" />
                        <TextBlock Text="完全離線" Foreground="White" FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Menu Grid.Row="1" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
              KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="主選單">
            <MenuItem Header="_檔案" AutomationProperties.Name="檔案選單">
                <MenuItem Header="存檔" Click="SaveProject_Click" AutomationProperties.Name="儲存模擬專案" />
                <MenuItem Header="讀取存檔" Click="LoadProject_Click" AutomationProperties.Name="讀取模擬專案" />
            </MenuItem>
            <MenuItem Header="_設定" AutomationProperties.Name="設定選單">
                <MenuItem Header="前往 V2 營運參數" Click="FocusV2Settings_Click" AutomationProperties.Name="前往 V2 營運參數" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#F8F9FB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer x:Name="ConfigurationScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="18,16,18,22">
                        <TextBlock Text="路線設定" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="路線編號" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteIdTextBox" Text="O" AutomationProperties.Name="路線編號" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="路線名稱" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="RouteNameTextBox" Text="橘色示範線" AutomationProperties.Name="路線名稱" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="車站與站間距離" Style="{StaticResource FieldLabel}" Margin="0,14,0,5" />
                        <DataGrid x:Name="StationDataGrid" Height="228" ItemsSource="{Binding StationRows}" RowHeaderWidth="0" AutomationProperties.Name="車站編輯表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="編號" Binding="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                                <DataGridTextColumn Header="站名" Binding="{Binding StationName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                <DataGridTextColumn Header="前站 km" Binding="{Binding DistanceFromPreviousKm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.###}" Width="74" />
                                <DataGridTextColumn Header="停站 s" Binding="{Binding DwellTimeSeconds, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="68" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增" Style="{StaticResource SecondaryButton}" Click="AddStation_Click" Margin="0,0,6,6" />
                            <Button Content="刪除" Style="{StaticResource SecondaryButton}" Click="RemoveStation_Click" Margin="0,0,6,6" />
                            <Button Content="上移" Style="{StaticResource SecondaryButton}" Click="MoveStationUp_Click" Margin="0,0,6,6" />
                            <Button Content="下移" Style="{StaticResource SecondaryButton}" Click="MoveStationDown_Click" Margin="0,0,6,6" />
                            <Button Content="載入示範" Style="{StaticResource SecondaryButton}" Click="LoadSample_Click" Margin="0,0,6,6" />
                        </WrapPanel>

                        <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
                        <TextBlock Text="列車性能" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="最高速度（km/h）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="MaxSpeedTextBox" Text="80" AutomationProperties.Name="最高速度" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="加速度（m/s²）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="AccelerationTextBox" Text="1.0" AutomationProperties.Name="加速度" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="減速度（m/s²）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DecelerationTextBox" Text="1.0" AutomationProperties.Name="減速度" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="預設停站（秒）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DefaultDwellTextBox" Text="30" AutomationProperties.Name="預設停站時間" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="起點折返（分鐘）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="OriginTurnaroundTextBox" Text="3" AutomationProperties.Name="起點折返時間" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="終點折返（分鐘）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TerminalTurnaroundTextBox" Text="6" AutomationProperties.Name="終點折返時間" />
                            </StackPanel>
                        </UniformGrid>

                        <Separator Margin="0,8,0,12" Background="{StaticResource BorderBrush}" />
                        <TextBlock x:Name="V2SettingsHeading" Text="V2 營運物理" Style="{StaticResource SectionTitle}"
                                   Focusable="True" KeyboardNavigation.IsTabStop="True" AutomationProperties.Name="V2 營運參數" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="速度曲線模式" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="OperationModeComboBox" SelectedIndex="1" AutomationProperties.Name="速度曲線模式">
                                    <ComboBoxItem Content="基礎物理模式（V1）" Tag="Basic" />
                                    <ComboBoxItem Content="實際營運模式（V2）" Tag="Realistic" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="移動閉塞" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="MovingBlockModeComboBox" SelectedIndex="2" SelectionChanged="MovingBlockMode_SelectionChanged" AutomationProperties.Name="移動閉塞模式">
                                    <ComboBoxItem Content="獨立運行" Tag="Independent" />
                                    <ComboBoxItem Content="監視（只告警）" Tag="Monitoring" />
                                    <ComboBoxItem Content="控制（防追撞）" Tag="Control" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="Jerk（m/s³）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="JerkTextBox" Text="0.65" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="惰行比例（0～1）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="CoastingRatioTextBox" Text="0.15" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="進站控制距離（m）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ApproachDistanceTextBox" Text="180" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="停站進站上限（km/h，0=自動）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ApproachSpeedTextBox" Text="0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="車長（m）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TrainLengthTextBox" Text="92" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="反應時間（s）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ReactionTimeTextBox" Text="1.5" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="營運煞車（m/s²）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="ServiceBrakeTextBox" Text="0.9" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="緊急煞車（m/s²）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="EmergencyBrakeTextBox" Text="1.3" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="里程區間速限（0.01 km）" Style="{StaticResource FieldLabel}" Margin="0,4,0,5" />
                        <DataGrid x:Name="SpeedLimitDataGrid" Height="162" ItemsSource="{Binding SpeedLimitRows}" RowHeaderWidth="0" AutomationProperties.Name="里程區間速限表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="起 km" Binding="{Binding StartKm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}" Width="62" />
                                <DataGridTextColumn Header="迄 km" Binding="{Binding EndKm, UpdateSourceTrigger=PropertyChanged, StringFormat=0.00}" Width="62" />
                                <DataGridTextColumn Header="km/h" Binding="{Binding LimitKmh, UpdateSourceTrigger=PropertyChanged, StringFormat=0.#}" Width="60" />
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" Width="68" />
                                <DataGridTextColumn Header="備註" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增速限" Style="{StaticResource SecondaryButton}" Click="AddSpeedLimit_Click" Margin="0,0,6,6" />
                            <Button Content="刪除速限" Style="{StaticResource SecondaryButton}" Click="RemoveSpeedLimit_Click" Margin="0,0,6,6" />
                            <TextBlock x:Name="SpeedLimitWarningText" Foreground="#A65A15" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </WrapPanel>

                        <TextBlock Text="停站／跨站服務模式" Style="{StaticResource FieldLabel}" Margin="0,10,0,5" />
                        <TextBlock Text="未列出的車站預設停站；起終點不可跨站。速度空白代表停站時使用自動煞車、跨站時不另加速限。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <DataGrid x:Name="ServicePatternDataGrid" Height="145" ItemsSource="{Binding ServicePatternRows}" RowHeaderWidth="0"
                                  AutomationProperties.Name="停站跨站服務模式表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="模式 ID" Binding="{Binding PatternId, UpdateSourceTrigger=PropertyChanged}" Width="82" />
                                <DataGridTextColumn Header="名稱" Binding="{Binding PatternName, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="車站" Binding="{Binding StationId, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                <DataGridTextColumn Header="停／跨" Binding="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" Width="58" />
                                <DataGridTextColumn Header="上限 km/h" Binding="{Binding SpeedLimitKmh, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增模式列" Style="{StaticResource SecondaryButton}" Click="AddServicePatternRow_Click" Margin="0,0,6,6" />
                            <Button Content="刪除模式列" Style="{StaticResource SecondaryButton}" Click="RemoveServicePatternRow_Click" Margin="0,0,6,6" />
                        </WrapPanel>

                        <TextBlock Text="車次套用模式" Style="{StaticResource FieldLabel}" Margin="0,6,0,5" />
                        <TextBlock Text="未列出的車次採普通車、ALL_STOP；折返後可用不同車次序號指定另一種模式。"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <DataGrid x:Name="ServiceRunDataGrid" Height="145" ItemsSource="{Binding ServiceRunRows}" RowHeaderWidth="0"
                                  AutomationProperties.Name="車次服務模式表">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="車輛" Binding="{Binding VehicleId, UpdateSourceTrigger=PropertyChanged}" Width="86" />
                                <DataGridTextColumn Header="序號" Binding="{Binding ServiceNumber, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                                <DataGridTextColumn Header="方向" Binding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <DataGridTextColumn Header="等級" Binding="{Binding ServiceClassId, UpdateSourceTrigger=PropertyChanged}" Width="64" />
                                <DataGridTextColumn Header="模式 ID" Binding="{Binding PatternId, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="新增車次" Style="{StaticResource SecondaryButton}" Click="AddServiceRun_Click" Margin="0,0,6,6" />
                            <Button Content="刪除車次" Style="{StaticResource SecondaryButton}" Click="RemoveServiceRun_Click" Margin="0,0,6,6" />
                        </WrapPanel>

                        <Separator Margin="0,8,0,12" Background="{StaticResource BorderBrush}" />
                        <TextBlock Text="模擬設定" Style="{StaticResource SectionTitle}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="列車數量" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TrainCountTextBox" Text="6" AutomationProperties.Name="列車數量" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="指定班距（分鐘，可空白）" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="HeadwayTextBox" Text="" AutomationProperties.Name="指定班距" />
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="首班發車時間" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="StartTimeTextBox" Text="06:00:00" AutomationProperties.Name="首班發車時間" />
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="播放倍率" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="PlaybackSpeedComboBox" SelectedIndex="2" AutomationProperties.Name="播放倍率">
                                    <ComboBoxItem Content="1×" Tag="1" />
                                    <ComboBoxItem Content="5×" Tag="5" />
                                    <ComboBoxItem Content="20×" Tag="20" />
                                    <ComboBoxItem Content="60×" Tag="60" />
                                    <ComboBoxItem Content="120×" Tag="120" />
                                </ComboBox>
                            </StackPanel>
                        </UniformGrid>

                        <Button x:Name="RunButton" Content="計算並建立模擬" Style="{StaticResource PrimaryButton}" Click="RunSimulation_Click" Margin="0,4,0,0" AutomationProperties.Name="計算並建立模擬" />
                        <Border x:Name="ValidationBorder" Background="#FFF1EC" BorderBrush="#F4A47D" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ValidationTextBlock" Foreground="#A83812" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="5">
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="車站 / 路線長度" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="RouteSummaryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="單程運行時間" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="OneWaySummaryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="完整循環時間" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="CycleSummaryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="理論班距" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="HeadwaySummaryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SummaryCard}">
                        <StackPanel>
                            <TextBlock Text="最高／峰值速度" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                            <TextBlock x:Name="SpeedSummaryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TabControl Grid.Row="1" Margin="5,8,5,5" Background="White" BorderBrush="{StaticResource BorderBrush}">
                    <TabItem Header="模擬動畫">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="260" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PlayButton" Content="▶ 播放" Style="{StaticResource PrimaryButton}" Click="Play_Click" IsEnabled="False" Margin="0,0,8,8" />
                                <Button Grid.Column="1" Content="Ⅱ 暫停" Style="{StaticResource SecondaryButton}" Click="Pause_Click" IsEnabled="True" Margin="0,0,8,8" />
                                <Button Grid.Column="2" Content="↺ 重設" Style="{StaticResource SecondaryButton}" Click="ResetPlayback_Click" Margin="0,0,0,8" />
                                <Button Grid.Column="3" x:Name="ObstacleStopButton" Content="⚠ 障礙物急停" Style="{StaticResource SecondaryButton}" Click="ObstacleStop_Click" IsEnabled="False" Margin="8,0,8,8" />
                                <TextBlock Grid.Column="5" x:Name="PlaybackStatusText" Text="請先建立模擬" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,8" />
                                <Border Grid.Column="6" Background="#EEF8F5" CornerRadius="7" Padding="12,7" Margin="0,0,0,8">
                                    <TextBlock x:Name="SimulationClockText" Text="--:--:--" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="15" />
                                </Border>
                            </Grid>
                            <Border Grid.Row="1" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="8">
                                <Canvas x:Name="RouteCanvas" SizeChanged="RouteCanvas_SizeChanged" AutomationProperties.Name="列車路線動畫" />
                            </Border>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="0.95*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="即時列車狀態" Style="{StaticResource SectionTitle}" />
                                    <DataGrid x:Name="CurrentTrainDataGrid" ItemsSource="{Binding CurrentTrainRows}" IsReadOnly="True" RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="列車" Binding="{Binding TrainId}" Width="75" />
                                            <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="55" />
                                            <DataGridTextColumn Header="狀態" Binding="{Binding State}" Width="72" />
                                            <DataGridTextColumn Header="位置 km" Binding="{Binding PositionKm}" Width="70" />
                                            <DataGridTextColumn Header="速度 km/h" Binding="{Binding SpeedKmh}" Width="80" />
                                            <DataGridTextColumn Header="下一站" Binding="{Binding NextStation}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="下行單程速度曲線" Style="{StaticResource SectionTitle}" />
                                    <Border Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                                        <Canvas x:Name="SpeedCanvas" Height="230" SizeChanged="SpeedCanvas_SizeChanged" AutomationProperties.Name="速度時間曲線" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="進出站時刻表">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="多列車下行時刻" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="　核心以秒計算，表格僅在輸出階段格式化" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="TimetableDataGrid" ItemsSource="{Binding TimetableRows}" IsReadOnly="True" RowHeaderWidth="0" FrozenColumnCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="列車" Binding="{Binding TrainId}" Width="82" />
                                    <DataGridTextColumn Header="方向" Binding="{Binding Direction}" Width="62" />
                                    <DataGridTextColumn Header="站號" Binding="{Binding StationId}" Width="68" />
                                    <DataGridTextColumn Header="車站" Binding="{Binding StationName}" Width="*" MinWidth="120" />
                                    <DataGridTextColumn Header="到站" Binding="{Binding ArrivalTime}" Width="95" />
                                    <DataGridTextColumn Header="出站" Binding="{Binding DepartureTime}" Width="95" />
                                    <DataGridTextColumn Header="停站" Binding="{Binding DwellTime}" Width="72" />
                                    <DataGridTextColumn Header="累積 km" Binding="{Binding PositionKm}" Width="82" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="區間物理明細">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="各站間解析模型" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="　自動判斷梯形或三角速度曲線" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" x:Name="SegmentDataGrid" ItemsSource="{Binding SegmentRows}" IsReadOnly="True" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="區間" Binding="{Binding Segment}" Width="*" MinWidth="160" />
                                    <DataGridTextColumn Header="距離 km" Binding="{Binding DistanceKm}" Width="84" />
                                    <DataGridTextColumn Header="曲線" Binding="{Binding Profile}" Width="74" />
                                    <DataGridTextColumn Header="峰值 km/h" Binding="{Binding PeakSpeedKmh}" Width="94" />
                                    <DataGridTextColumn Header="旅行時間" Binding="{Binding TravelTime}" Width="90" />
                                    <DataGridTextColumn Header="加速" Binding="{Binding AccelerationTime}" Width="78" />
                                    <DataGridTextColumn Header="巡航" Binding="{Binding CruisingTime}" Width="78" />
                                    <DataGridTextColumn Header="減速" Binding="{Binding DecelerationTime}" Width="78" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="2" Background="#F4F6FA" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                                <TextBlock Text="基礎模式保留 V1.0 三角形／梯形解析結果；V2 是營運與號誌概念模擬，不代表真實 ATP／ATO／ATS 或鐵路安全認證。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="移動閉塞與煞車">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="250" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel>
                                <TextBlock Text="煞車估算" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,8" />
                                <ComboBox x:Name="BrakingModeComboBox" Width="120" SelectedIndex="0" SelectionChanged="BrakingMode_SelectionChanged" Margin="0,0,10,8">
                                    <ComboBoxItem Content="營運煞車" Tag="Service" />
                                    <ComboBoxItem Content="緊急煞車" Tag="Emergency" />
                                </ComboBox>
                                <ComboBox x:Name="SafetyPairComboBox" Width="180" SelectionChanged="SafetyPair_SelectionChanged" Margin="0,0,10,8" />
                                <ComboBox x:Name="SafetyDirectionComboBox" Width="82" SelectedIndex="0" SelectionChanged="SafetyFilter_Changed" Margin="0,0,8,8">
                                    <ComboBoxItem Content="全方向" Tag="All" />
                                    <ComboBoxItem Content="下行" Tag="Outbound" />
                                    <ComboBoxItem Content="上行" Tag="Inbound" />
                                </ComboBox>
                                <ComboBox x:Name="SafetyStatusComboBox" Width="110" SelectedIndex="0" SelectionChanged="SafetyFilter_Changed" Margin="0,0,8,8">
                                    <ComboBoxItem Content="全狀態" Tag="All" />
                                    <ComboBoxItem Content="安全" Tag="Safe" />
                                    <ComboBoxItem Content="警戒" Tag="Caution" />
                                    <ComboBoxItem Content="需制動" Tag="BrakingRequired" />
                                    <ComboBoxItem Content="侵入" Tag="EnvelopeIntrusion" />
                                </ComboBox>
                                <ComboBox x:Name="SafetyWindowComboBox" Width="100" SelectedIndex="1" SelectionChanged="SafetyFilter_Changed" Margin="0,0,8,8">
                                    <ComboBoxItem Content="最近 60 s" Tag="60" />
                                    <ComboBoxItem Content="最近 300 s" Tag="300" />
                                    <ComboBoxItem Content="全部時間" Tag="All" />
                                </ComboBox>
                                <TextBlock Text="障礙車" VerticalAlignment="Center" Margin="0,0,5,8" />
                                <ComboBox x:Name="ObstacleTrainComboBox" Width="105" Margin="0,0,6,8" />
                                <TextBlock Text="延遲 s" VerticalAlignment="Center" Margin="0,0,5,8" />
                                <TextBox x:Name="ObstacleDelayTextBox" Width="52" Text="0" Margin="0,0,6,8" />
                                <Button Content="觸發／排程急停" Style="{StaticResource SecondaryButton}" Click="ObstacleStop_Click" Margin="0,0,10,8" />
                                <TextBlock x:Name="SafetySummaryText" Text="建立 V2 模擬後顯示安全摘要。" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
                            </WrapPanel>
                            <Border Grid.Row="1" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                                <Canvas x:Name="SafetyDistanceCanvas" SizeChanged="SafetyDistanceCanvas_SizeChanged" AutomationProperties.Name="相鄰列車距離時間圖" />
                            </Border>
                            <DataGrid Grid.Row="2" x:Name="SafetyDataGrid" ItemsSource="{Binding SafetyRows}" IsReadOnly="True" RowHeaderWidth="0" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="後車 → 前車" Binding="{Binding Pair}" Width="130" />
                                    <DataGridTextColumn Header="軌道" Binding="{Binding Track}" Width="55" />
                                    <DataGridTextColumn Header="後車頭 km" Binding="{Binding FollowerKm}" Width="82" />
                                    <DataGridTextColumn Header="前車尾 km" Binding="{Binding LeaderRearKm}" Width="82" />
                                    <DataGridTextColumn Header="淨距 m" Binding="{Binding GapMeters}" Width="72" />
                                    <DataGridTextColumn Header="安全距離 m" Binding="{Binding SafetyMeters}" Width="86" />
                                    <DataGridTextColumn Header="煞車需求 m" Binding="{Binding BrakeDemandMeters}" Width="86" />
                                    <DataGridTextColumn Header="安全裕度 m" Binding="{Binding MarginMeters}" Width="82" />
                                    <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="列車運行圖／匯出">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBlock Text="方向" VerticalAlignment="Center" Margin="0,0,5,6" />
                                <ComboBox x:Name="DiagramDirectionComboBox" Width="92" SelectedIndex="0" SelectionChanged="DiagramFilter_Changed" Margin="0,0,10,6">
                                    <ComboBoxItem Content="全部" Tag="All" />
                                    <ComboBoxItem Content="下行" Tag="Outbound" />
                                    <ComboBoxItem Content="上行" Tag="Inbound" />
                                </ComboBox>
                                <TextBlock Text="車輛" VerticalAlignment="Center" Margin="0,0,5,6" />
                                <ComboBox x:Name="DiagramVehicleComboBox" Width="125" SelectionChanged="DiagramFilter_Changed" Margin="0,0,10,6" />
                                <CheckBox x:Name="ShowPlannedCheckBox" Content="計畫／理論" IsChecked="True" Checked="DiagramFilter_Changed" Unchecked="DiagramFilter_Changed" Margin="0,0,10,6" VerticalAlignment="Center" />
                                <CheckBox x:Name="ShowActualCheckBox" Content="模擬實際" IsChecked="True" Checked="DiagramFilter_Changed" Unchecked="DiagramFilter_Changed" Margin="0,0,10,6" VerticalAlignment="Center" />
                                <TextBlock Text="縮放" VerticalAlignment="Center" Margin="0,0,5,6" />
                                <Slider x:Name="DiagramZoomSlider" Minimum="1" Maximum="4" Value="1" Width="100" ValueChanged="DiagramZoom_Changed" Margin="0,0,10,6" />
                                <TextBlock Text="起 min" VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox x:Name="DiagramStartMinuteTextBox" Width="48" Text="0" TextChanged="DiagramTimeFilter_TextChanged" Margin="0,0,7,6" />
                                <TextBlock Text="迄 min" VerticalAlignment="Center" Margin="0,0,4,6" />
                                <TextBox x:Name="DiagramEndMinuteTextBox" Width="55" Text="" TextChanged="DiagramTimeFilter_TextChanged" Margin="0,0,10,6" />
                                <CheckBox x:Name="HighResolutionCheckBox" Content="高解析 PNG" Margin="0,0,10,6" VerticalAlignment="Center" />
                                <ComboBox x:Name="PdfPageSizeComboBox" Width="68" SelectedIndex="0" Margin="0,0,6,6">
                                    <ComboBoxItem Content="A4" Tag="A4" />
                                    <ComboBoxItem Content="A3" Tag="A3" />
                                </ComboBox>
                                <CheckBox x:Name="PdfSplitPagesCheckBox" Content="PDF 分頁" IsChecked="True" Margin="0,0,10,6" VerticalAlignment="Center" />
                                <Button Content="匯出 PNG" Style="{StaticResource SecondaryButton}" Click="ExportPng_Click" Margin="0,0,6,6" />
                                <Button Content="匯出 PDF" Style="{StaticResource SecondaryButton}" Click="ExportPdf_Click" Margin="0,0,6,6" />
                                <Button Content="匯出 CSV" Style="{StaticResource SecondaryButton}" Click="ExportCsv_Click" Margin="0,0,6,6" />
                            </WrapPanel>
                            <Border Grid.Row="1" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                                <ScrollViewer x:Name="DiagramScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <Canvas x:Name="TimeDistanceCanvas" MinWidth="760" MinHeight="380" SizeChanged="TimeDistanceCanvas_SizeChanged" AutomationProperties.Name="時間里程列車運行圖" />
                                </ScrollViewer>
                            </Border>
                            <DataGrid Grid.Row="2" x:Name="EventDataGrid" ItemsSource="{Binding EventRows}" IsReadOnly="True" RowHeaderWidth="0" Margin="0,10,0,0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="時間" Binding="{Binding Time}" Width="95" />
                                    <DataGridTextColumn Header="事件" Binding="{Binding Type}" Width="110" />
                                    <DataGridTextColumn Header="車輛／車次" Binding="{Binding Vehicle}" Width="130" />
                                    <DataGridTextColumn Header="里程 km" Binding="{Binding PositionKm}" Width="80" />
                                    <DataGridTextColumn Header="說明" Binding="{Binding Message}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="#202C43">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="就緒。請調整參數後建立模擬。" Foreground="#DCE2ED" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="1" Text="核心單位：m · s · m/s · m/s²" Foreground="#9EAABE" VerticalAlignment="Center" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
